---
const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-[#89B4FA] font-medium text-xs md:text-sm
  shadow-md hover:shadow-xl transition-all duration-300 ease-out hover:-translate-y-0.5 active:translate-y-0"
>
  <slot />
</a>
