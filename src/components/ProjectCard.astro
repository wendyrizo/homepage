---
import type { Project } from "../data/projects";
const project = Astro.props as Project;
---

<a
  href={project.link}
  target="_blank"
  rel="noopener noreferrer"
  class="group block"
>
  <article class="flex flex-col gap-3">
    <div class="overflow-hidden rounded">
      <img
        src={project.image}
        alt={`Image of ${project.name}`}
        class="shadow-lg aspect-video object-cover transition duration-500 ease-in-out group-hover:scale-105"
      />
    </div>
    <h3>{project.name}</h3>
    <p class="text-sm text-neutral-400">{project.description}</p>
  </article>
</a>
